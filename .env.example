# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → your project → Settings (gear) → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...   # "anon public" key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...        # "service_role" secret key — never expose client-side

# ─── Resend ──────────────────────────────────────────────────────────────────
# https://resend.com/api-keys → Create API Key
# Also verify the sending domain (guelma.guide) at https://resend.com/domains
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Admin ───────────────────────────────────────────────────────────────────
# Any strong random string — passed as the "x-admin-secret" header when calling
# POST /api/admin/generate-key
ADMIN_SECRET=change-me-to-a-strong-random-secret

# ─── App URL ─────────────────────────────────────────────────────────────────
# Your production domain. Used for Open Graph metadata, sitemap, and robots.txt.
# Set to your Vercel deployment URL (e.g. https://guelma.guide) after deploy.
NEXT_PUBLIC_APP_URL=https://guelma.guide
